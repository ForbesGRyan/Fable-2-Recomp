+void CommandProcessor::Pm4DumpType0(uint32_t base_index, uint32_t count, bool write_one_reg) {
+  const RegisterFile& regs = *register_file_;
+  // Shader constants, fetch constants and the like are too many: only the
+  // scalar state registers below 0x2000 are listed, and a range is listed by
+  // its first register plus the count.
+  if (base_index >= 0x2000) {
+    return;
+  }
+  const uint32_t listed = std::min(count, uint32_t(8));
+  for (uint32_t m = 0; m < listed; ++m) {
+    const uint32_t index = write_one_reg ? base_index : base_index + m;
+    const RegisterInfo* info = RegisterFile::GetRegisterInfo(index);
+    std::fprintf(pm4_dump_file_, "  R %04X %-32s = %08X\n", index, info ? info->name : "?",
+                 regs.values[index]);
+  }
+  if (count > listed) {
+    std::fprintf(pm4_dump_file_, "  R ... %u more\n", count - listed);
+  }
+}
+
+void CommandProcessor::Pm4DumpType3(uint32_t opcode, uint32_t count, bool predicated,
+                                    bool skipped) {
+  const RegisterFile& regs = *register_file_;
+  const char* name = "";
+  switch (opcode) {
+    case PM4_DRAW_INDX: name = "DRAW_INDX"; break;
+    case PM4_DRAW_INDX_2: name = "DRAW_INDX_2"; break;
+    case PM4_SET_BIN_MASK: name = "SET_BIN_MASK"; break;
+    case PM4_SET_BIN_SELECT: name = "SET_BIN_SELECT"; break;
+    case PM4_SET_BIN_MASK_LO: name = "SET_BIN_MASK_LO"; break;
+    case PM4_SET_BIN_MASK_HI: name = "SET_BIN_MASK_HI"; break;
+    case PM4_SET_BIN_SELECT_LO: name = "SET_BIN_SELECT_LO"; break;
+    case PM4_SET_BIN_SELECT_HI: name = "SET_BIN_SELECT_HI"; break;
+    case PM4_INDIRECT_BUFFER: name = "INDIRECT_BUFFER"; break;
+    case PM4_INDIRECT_BUFFER_PFD: name = "INDIRECT_BUFFER_PFD"; break;
+    case PM4_WAIT_REG_MEM: name = "WAIT_REG_MEM"; break;
+    case PM4_EVENT_WRITE: name = "EVENT_WRITE"; break;
+    case PM4_EVENT_WRITE_SHD: name = "EVENT_WRITE_SHD"; break;
+    case PM4_EVENT_WRITE_EXT: name = "EVENT_WRITE_EXT"; break;
+    case PM4_XE_SWAP: name = "XE_SWAP"; break;
+    case PM4_SET_CONSTANT: name = "SET_CONSTANT"; break;
+    case PM4_SET_SHADER_CONSTANTS: name = "SET_SHADER_CONSTANTS"; break;
+    case PM4_LOAD_ALU_CONSTANT: name = "LOAD_ALU_CONSTANT"; break;
+    case PM4_IM_LOAD: name = "IM_LOAD"; break;
+    case PM4_IM_LOAD_IMMEDIATE: name = "IM_LOAD_IMMEDIATE"; break;
+    case PM4_INVALIDATE_STATE: name = "INVALIDATE_STATE"; break;
+    case PM4_NOP: name = "NOP"; break;
+    case PM4_MEM_WRITE: name = "MEM_WRITE"; break;
+    case PM4_REG_RMW: name = "REG_RMW"; break;
+    case PM4_COND_WRITE: name = "COND_WRITE"; break;
+    case PM4_CONTEXT_UPDATE: name = "CONTEXT_UPDATE"; break;
+    default: break;
+  }
+  const bool is_draw = opcode == PM4_DRAW_INDX || opcode == PM4_DRAW_INDX_2;
+  const bool is_copy = regs.Get<reg::RB_MODECONTROL>().edram_mode == xenos::EdramMode::kCopy;
+  std::fprintf(pm4_dump_file_, "T3 %02X %-20s n=%u%s%s sel=%016llX mask=%016llX", opcode, name,
+               count, predicated ? " pred" : "", skipped ? " SKIP" : "",
+               (unsigned long long)bin_select_, (unsigned long long)bin_mask_);
+  if (is_draw && !skipped) {
+    std::fprintf(pm4_dump_file_,
+                 " %s surf=%08X color=%08X depth=%08X winoff=%08X wscis=%08X/%08X "
+                 "sscis=%08X/%08X vport=%08X,%08X copy=%08X/%08X",
+                 is_copy ? "COPY" : "DRAW", regs.values[XE_GPU_REG_RB_SURFACE_INFO],
+                 regs.values[XE_GPU_REG_RB_COLOR_INFO], regs.values[XE_GPU_REG_RB_DEPTH_INFO],
+                 regs.values[XE_GPU_REG_PA_SC_WINDOW_OFFSET],
+                 regs.values[XE_GPU_REG_PA_SC_WINDOW_SCISSOR_TL],
+                 regs.values[XE_GPU_REG_PA_SC_WINDOW_SCISSOR_BR],
+                 regs.values[XE_GPU_REG_PA_SC_SCREEN_SCISSOR_TL],
+                 regs.values[XE_GPU_REG_PA_SC_SCREEN_SCISSOR_BR],
+                 regs.values[XE_GPU_REG_PA_CL_VPORT_XOFFSET],
+                 regs.values[XE_GPU_REG_PA_CL_VPORT_YOFFSET],
+                 regs.values[XE_GPU_REG_RB_COPY_CONTROL], regs.values[XE_GPU_REG_RB_COPY_DEST_BASE]);
+  }
+  std::fputc('\n', pm4_dump_file_);
+}
