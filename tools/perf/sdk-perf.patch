+bool D3D12CommandProcessor::InitializeGpuTimestamps() {
+  if (gpu_timestamp_heap_) {
+    return true;
+  }
+  const ui::d3d12::D3D12Provider& provider = GetD3D12Provider();
+  ID3D12Device* device = provider.GetDevice();
+  if (FAILED(provider.GetDirectQueue()->GetTimestampFrequency(&gpu_timestamp_frequency_)) ||
+      !gpu_timestamp_frequency_) {
+    return false;
+  }
+  D3D12_QUERY_HEAP_DESC heap_desc = {};
+  heap_desc.Type = D3D12_QUERY_HEAP_TYPE_TIMESTAMP;
+  heap_desc.Count = kGpuTimestampSlots * 2;
+  if (FAILED(device->CreateQueryHeap(&heap_desc, IID_PPV_ARGS(&gpu_timestamp_heap_)))) {
+    return false;
+  }
+  D3D12_RESOURCE_DESC buffer_desc;
+  ui::d3d12::util::FillBufferResourceDesc(buffer_desc, kGpuTimestampSlots * 2 * sizeof(uint64_t),
+                                          D3D12_RESOURCE_FLAG_NONE);
+  if (FAILED(device->CreateCommittedResource(
+          &ui::d3d12::util::kHeapPropertiesReadback, provider.GetHeapFlagCreateNotZeroed(),
+          &buffer_desc, D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+          IID_PPV_ARGS(&gpu_timestamp_readback_)))) {
+    ui::d3d12::util::ReleaseAndNull(gpu_timestamp_heap_);
+    return false;
+  }
+  D3D12_RANGE read_range = {0, kGpuTimestampSlots * 2 * sizeof(uint64_t)};
+  void* mapped = nullptr;
+  if (FAILED(gpu_timestamp_readback_->Map(0, &read_range, &mapped))) {
+    ui::d3d12::util::ReleaseAndNull(gpu_timestamp_readback_);
+    ui::d3d12::util::ReleaseAndNull(gpu_timestamp_heap_);
+    return false;
+  }
+  gpu_timestamp_mapped_ = static_cast<const uint64_t*>(mapped);
+  return true;
+}
+
+// Worker thread only. Reads the timestamps of submissions whose fence has passed.
+void D3D12CommandProcessor::ReadCompletedGpuTimestamps() {
+  if (pending_gpu_timestamps_.empty()) {
+    return;
+  }
+  const uint64_t completed = submission_fence_->GetCompletedValue();
+  while (!pending_gpu_timestamps_.empty() &&
+         pending_gpu_timestamps_.front().fence_value <= completed) {
+    const PendingGpuTimestamp& p = pending_gpu_timestamps_.front();
+    const uint64_t t0 = gpu_timestamp_mapped_[p.slot * 2];
+    const uint64_t t1 = gpu_timestamp_mapped_[p.slot * 2 + 1];
+    if (t1 > t0 && gpu_timestamp_frequency_) {
+      NoteEmulatedGpuTime(uint64_t((t1 - t0) * 1000000000.0 / double(gpu_timestamp_frequency_)));
+    }
+    pending_gpu_timestamps_.pop_front();
+  }
+}
+
+void D3D12CommandProcessor::StartAsyncSubmitThread() {
+  if (async_submit_running_) {
+    return;
+  }
+  InitializeGpuTimestamps();
+  async_submit_running_ = true;
+  async_submit_thread_ = std::thread([this]() {
+    SetThreadDescription(GetCurrentThread(), L"D3D12 Submit");
+    AsyncSubmitThreadMain();
+  });
+}
+
+void D3D12CommandProcessor::StopAsyncSubmitThread() {
+  if (!async_submit_running_) {
+    return;
+  }
+  FlushAsyncSubmissions();
+  {
+    std::lock_guard<std::mutex> lock(async_submit_mutex_);
+    async_submit_running_ = false;
+  }
+  async_submit_cv_.notify_all();
+  if (async_submit_thread_.joinable()) {
+    async_submit_thread_.join();
+  }
+}
+
+void D3D12CommandProcessor::FlushAsyncSubmissions() {
+  if (!async_submit_running_) {
+    return;
+  }
+  std::unique_lock<std::mutex> lock(async_submit_mutex_);
+  if (async_submit_queue_.empty() && async_submissions_executed_ >= async_submissions_enqueued_) {
+    return;
+  }
+  async_submit_flush_requested_ = true;
+  async_submit_cv_.notify_one();
+  async_submit_done_cv_.wait(lock, [this]() {
+    return async_submit_queue_.empty() &&
+           async_submissions_executed_ >= async_submissions_enqueued_;
+  });
+}
+
+void D3D12CommandProcessor::AsyncSubmitThreadMain() {
+  ID3D12CommandQueue* direct_queue = GetD3D12Provider().GetDirectQueue();
+  // The open command list: jobs recorded into it since the last ExecuteCommandLists.
+  bool list_open = false;
+  uint32_t recorded = 0;
+  uint64_t last_fence_value = 0;
+  bool collect_stats = false;
+  std::chrono::steady_clock::time_point t0{};
+  std::vector<AsyncSubmission> jobs;
+  while (true) {
+    jobs.clear();
+    bool execute_now = false;
+    {
+      std::unique_lock<std::mutex> lock(async_submit_mutex_);
+      async_submit_cv_.wait(lock, [this]() {
+        return !async_submit_queue_.empty() || async_submit_flush_requested_ ||
+               !async_submit_running_;
+      });
+      if (async_submit_queue_.empty() && !async_submit_flush_requested_) {
+        if (!async_submit_running_) {
+          return;
+        }
+        continue;
+      }
+      const uint32_t coalesce = std::max(uint32_t(1), REXCVAR_GET(d3d12_async_submit_coalesce));
+      while (!async_submit_queue_.empty() && recorded + jobs.size() < coalesce) {
+        jobs.push_back(std::move(async_submit_queue_.front()));
+        async_submit_queue_.pop_front();
+      }
+      // Execute when asked to flush, when the cap is reached, or (without the
+      // on-flush mode) whenever something was recorded.
+      const bool on_flush = REXCVAR_GET(d3d12_async_submit_on_flush);
+      execute_now = async_submit_flush_requested_ ||
+                    recorded + jobs.size() >= coalesce || !on_flush;
+      if (async_submit_flush_requested_ && async_submit_queue_.empty()) {
+        async_submit_flush_requested_ = false;
+      }
+    }
+    for (AsyncSubmission& job : jobs) {
+      if (!list_open) {
+        // All merged submissions record into this job's allocator; the others'
+        // allocators are recycled by the fence like any other and reset before
+        // their next use.
+        collect_stats = job.collect_stats;
+        if (collect_stats) t0 = std::chrono::steady_clock::now();
+        job.command_allocator->Reset();
+        command_list_->Reset(job.command_allocator, nullptr);
+        list_open = true;
+        if (collect_stats && gpu_timestamp_heap_ &&
+            pending_gpu_timestamps_.size() < kGpuTimestampSlots - 1) {
+          command_list_->EndQuery(gpu_timestamp_heap_, D3D12_QUERY_TYPE_TIMESTAMP,
+                                  gpu_timestamp_next_slot_ * 2);
+        }
+      } else {
+        // The ExecuteCommandLists boundary the subsystems assume between
+        // submissions is a full UAV and aliasing barrier.
+        D3D12_RESOURCE_BARRIER barriers[2] = {};
+        barriers[0].Type = D3D12_RESOURCE_BARRIER_TYPE_UAV;
+        barriers[0].UAV.pResource = nullptr;
+        barriers[1].Type = D3D12_RESOURCE_BARRIER_TYPE_ALIASING;
+        barriers[1].Aliasing.pResourceBefore = nullptr;
+        barriers[1].Aliasing.pResourceAfter = nullptr;
+        command_list_->ResourceBarrier(2, barriers);
+      }
+      DeferredCommandList::ExecuteStream(job.stream.data(), job.stream.size(), *this,
+                                         command_list_, command_list_1_);
+      last_fence_value = job.fence_value;
+      ++recorded;
+    }
+    if (!execute_now || !list_open) {
+      if (!list_open) {
+        // A flush with nothing recorded: nothing to execute.
+        async_submit_done_cv_.notify_all();
+      }
+      continue;
+    }
+    bool timed = false;
+    if (collect_stats && gpu_timestamp_heap_ &&
+        pending_gpu_timestamps_.size() < kGpuTimestampSlots - 1) {
+      const uint32_t slot = gpu_timestamp_next_slot_;
+      command_list_->EndQuery(gpu_timestamp_heap_, D3D12_QUERY_TYPE_TIMESTAMP, slot * 2 + 1);
+      command_list_->ResolveQueryData(gpu_timestamp_heap_, D3D12_QUERY_TYPE_TIMESTAMP, slot * 2, 2,
+                                      gpu_timestamp_readback_, slot * 2 * sizeof(uint64_t));
