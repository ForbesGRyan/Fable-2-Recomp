+void D3D12CommandProcessor::CompletePendingForcedReadbacks(bool wait) {
+  if (pending_forced_readbacks_.empty()) {
+    return;
+  }
+  if (wait) {
+    uint64_t newest = 0;
+    for (const PendingForcedReadback& p : pending_forced_readbacks_) {
+      newest = std::max(newest, p.submission);
+    }
+    CheckSubmissionFence(newest);
+  } else {
+    submission_completed_ = std::max(submission_completed_, submission_fence_->GetCompletedValue());
+  }
+  for (PendingForcedReadback& p : pending_forced_readbacks_) {
+    if (p.submission > submission_completed_) {
+      continue;
+    }
+    auto it = readback_buffers_.find(p.resolve_key);
+    if (it != readback_buffers_.end()) {
+      ReadbackBuffer& rb = it->second;
+      uint8_t* destination = memory_->TranslatePhysical(p.address);
+      if (destination && rb.mapped_data[p.buffer_index] && p.length <= rb.sizes[p.buffer_index]) {
+        std::memcpy(destination, static_cast<uint8_t*>(rb.mapped_data[p.buffer_index]), p.length);
+      }
+    }
+    p.length = 0;
+  }
+  pending_forced_readbacks_.erase(
+      std::remove_if(pending_forced_readbacks_.begin(), pending_forced_readbacks_.end(),
+                     [](const PendingForcedReadback& p) { return p.length == 0; }),
+      pending_forced_readbacks_.end());
+}
