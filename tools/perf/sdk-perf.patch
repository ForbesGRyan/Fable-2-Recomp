+void D3D12CommandProcessor::StartAsyncSubmitThread() {
+  if (async_submit_running_) {
+    return;
+  }
+  async_submit_running_ = true;
+  async_submit_thread_ = std::thread([this]() {
+    SetThreadDescription(GetCurrentThread(), L"D3D12 Submit");
+    AsyncSubmitThreadMain();
+  });
+}
+
+void D3D12CommandProcessor::StopAsyncSubmitThread() {
+  if (!async_submit_running_) {
+    return;
+  }
+  FlushAsyncSubmissions();
+  {
+    std::lock_guard<std::mutex> lock(async_submit_mutex_);
+    async_submit_running_ = false;
+  }
+  async_submit_cv_.notify_all();
+  if (async_submit_thread_.joinable()) {
+    async_submit_thread_.join();
+  }
+}
+
+void D3D12CommandProcessor::FlushAsyncSubmissions() {
+  if (!async_submit_running_) {
+    return;
+  }
+  std::unique_lock<std::mutex> lock(async_submit_mutex_);
+  async_submit_done_cv_.wait(lock, [this]() {
+    return async_submit_queue_.empty() &&
+           async_submissions_executed_ >= async_submissions_enqueued_;
+  });
+}
+
+void D3D12CommandProcessor::AsyncSubmitThreadMain() {
+  ID3D12CommandQueue* direct_queue = GetD3D12Provider().GetDirectQueue();
+  std::vector<AsyncSubmission> jobs;
+  while (true) {
+    jobs.clear();
+    {
+      std::unique_lock<std::mutex> lock(async_submit_mutex_);
+      async_submit_cv_.wait(lock, [this]() {
+        return !async_submit_queue_.empty() || !async_submit_running_;
+      });
+      if (async_submit_queue_.empty()) {
+        if (!async_submit_running_) {
+          return;
+        }
+        continue;
+      }
+      const uint32_t coalesce = std::max(uint32_t(1), REXCVAR_GET(d3d12_async_submit_coalesce));
+      while (!async_submit_queue_.empty() && jobs.size() < coalesce) {
+        jobs.push_back(std::move(async_submit_queue_.front()));
+        async_submit_queue_.pop_front();
+      }
+    }
+    const bool collect_stats = jobs.front().collect_stats;
+    const auto t0 = collect_stats ? std::chrono::steady_clock::now()
+                                  : std::chrono::steady_clock::time_point{};
+    // All merged submissions record into the first job's allocator; the others'
+    // allocators are left reset-free (they are recycled by the fence like any
+    // other, and reset before their next use).
+    jobs.front().command_allocator->Reset();
+    command_list_->Reset(jobs.front().command_allocator, nullptr);
+    for (size_t i = 0; i < jobs.size(); ++i) {
+      if (i != 0) {
+        // The ExecuteCommandLists boundary the subsystems assume between
+        // submissions is a full UAV and aliasing barrier.
+        D3D12_RESOURCE_BARRIER barriers[2] = {};
+        barriers[0].Type = D3D12_RESOURCE_BARRIER_TYPE_UAV;
+        barriers[0].UAV.pResource = nullptr;
+        barriers[1].Type = D3D12_RESOURCE_BARRIER_TYPE_ALIASING;
+        barriers[1].Aliasing.pResourceBefore = nullptr;
+        barriers[1].Aliasing.pResourceAfter = nullptr;
+        command_list_->ResourceBarrier(2, barriers);
+      }
+      DeferredCommandList::ExecuteStream(jobs[i].stream.data(), jobs[i].stream.size(), *this,
+                                         command_list_, command_list_1_);
+    }
+    command_list_->Close();
+    ID3D12CommandList* execute_command_lists[] = {command_list_};
+    direct_queue->ExecuteCommandLists(1, execute_command_lists);
+    const uint64_t last_fence_value = jobs.back().fence_value;
+    direct_queue->Signal(submission_fence_, last_fence_value);
+    if (collect_stats) {
+      // Reported as "submit" time measured on the worker, not the CP thread's time.
+      NoteEmulatedSubmission(uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                          std::chrono::steady_clock::now() - t0)
+                                          .count()));
+    }
+    {
+      std::lock_guard<std::mutex> lock(async_submit_mutex_);
+      async_submissions_executed_ = last_fence_value;
+    }
+    async_submit_done_cv_.notify_all();
+  }
+}
